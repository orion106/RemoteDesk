<UserControl x:Class="RemoteAssist.LabView" x:Name="LabRoot"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="{DynamicResource TextBrush}">
 <UserControl.Resources>
  <Style x:Key="LabLabel" TargetType="TextBlock"><Setter Property="Margin" Value="0,10,0,4"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
  <Style x:Key="LabButton" TargetType="Button"><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Padding" Value="12,8"/><Setter Property="MinHeight" Value="38"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource HoverBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource LineBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value=".4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="LabGrid" TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="MinHeight" Value="160"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/><Setter Property="Background" Value="{DynamicResource PanelBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="RowBackground" Value="{DynamicResource PanelBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource LineBrush}"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="42"/><Setter Property="ColumnHeaderHeight" Value="40"/><Setter Property="SelectionMode" Value="Single"/></Style>
  <Style TargetType="Expander"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Margin" Value="0,12,0,0"/></Style>
 </UserControl.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="24,14,24,8"><Button DockPanel.Dock="Right" Content="Отменить операцию" Command="{Binding CancelCommand}"/><TextBlock Text="{Binding Summary}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/></DockPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="24,4,24,16">
    <StackPanel x:Name="RoomsPanel">
     <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Section, ElementName=LabRoot}" Value="Аудитории"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
     <TextBlock Text="Компьютерные классы" FontSize="25" FontWeight="SemiBold"/>
     <TextBlock Text="Одна карточка — один физический ПК. Отметьте компьютеры для группового действия." Style="{DynamicResource MutedText}" Margin="0,6,0,14"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding Rooms}" SelectedItem="{Binding Room}" Margin="0,0,10,0"/><TextBox Grid.Column="1" Text="{Binding Query,UpdateSourceTrigger=PropertyChanged}" Tag="Поиск: имя, место, адрес, серийный номер"/></Grid>
     <WrapPanel Margin="0,12,0,0"><Button Content="CSV из GLPI" Command="{Binding ImportCsvCommand}" Style="{StaticResource LabButton}"/><Button Content="Из Active Directory" Command="{Binding ImportAdCommand}" Style="{StaticResource LabButton}"/><Button Content="GLPI через API" Command="{Binding ImportCommand}" Style="{StaticResource LabButton}"/><Button Content="Проверить состояние" Command="{Binding PollCommand}" Style="{StaticResource LabButton}"/><Button Content="Выбрать аудиторию" Command="{Binding SelectAllCommand}" Style="{StaticResource LabButton}"/><Button Content="Снять отметки" Command="{Binding SelectNoneCommand}" Style="{StaticResource LabButton}"/></WrapPanel>
     <ListBox x:Name="ComputerCards" ItemsSource="{Binding ComputersView}" SelectedItem="{Binding SelectedComputer}" Height="300" Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,10,10"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><Border Width="240" Padding="14" CornerRadius="8" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
       <StackPanel><DockPanel><CheckBox DockPanel.Dock="Right" IsChecked="{Binding Selected,UpdateSourceTrigger=PropertyChanged}" ToolTip="Включить в групповое действие"/><TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></DockPanel>
        <TextBlock Text="{Binding Seat}" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,10"/><TextBlock Text="{Binding ActiveOs}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding Status}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/><TextBlock Text="{Binding User}" FontSize="12" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Checked}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/>
       </StackPanel><Border.ToolTip><TextBlock Text="{Binding Detail}" MaxWidth="500" TextWrapping="Wrap"/></Border.ToolTip>
      </Border></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <WrapPanel Margin="0,10,0,0"><Button Content="Включить → Astra" Command="{Binding PowerCommand}" CommandParameter="Wake" Style="{StaticResource LabButton}"/><Button Content="Включить → Windows" Command="{Binding PowerCommand}" CommandParameter="WakeWindows" Style="{StaticResource LabButton}"/><Button Content="Загрузить Windows" Command="{Binding PowerCommand}" CommandParameter="BootWindows" Style="{StaticResource LabButton}"/><Button Content="Перезагрузить → Astra" Command="{Binding PowerCommand}" CommandParameter="RestartAstra" Style="{StaticResource LabButton}"/><Button Content="Выключить" Command="{Binding PowerCommand}" CommandParameter="Shutdown" Style="{StaticResource LabButton}"/></WrapPanel>
     <WrapPanel><Button Content="Помощь выбранному ПК" Command="{Binding ConnectCommand}" Style="{StaticResource LabButton}"/><Button Content="Закрыть помощь Astra" Command="{Binding DisconnectCommand}" Style="{StaticResource LabButton}"/><Button Content="Диагностика выбранного ПК" Command="{Binding DiagnoseCommand}" Style="{StaticResource LabButton}"/><Button Content="Объединить две записи" Command="{Binding MergeCommand}" Style="{StaticResource LabButton}"/></WrapPanel>
     <Expander Header="Карточка компьютера и настройка GRUB" IsExpanded="False"><Border Style="{DynamicResource Card}" Margin="0,10,0,0"><StackPanel>
      <Button Content="Добавить компьютер" Command="{Binding NewComputerCommand}" HorizontalAlignment="Left"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="Имя компьютера" Style="{StaticResource LabLabel}"/><TextBox Text="{Binding ComputerDraft.Name}"/>
        <TextBlock Text="Аудитория" Style="{StaticResource LabLabel}"/><TextBox Text="{Binding ComputerDraft.Room}" IsReadOnly="{Binding LinkedPlacementReadOnly}"/>
        <TextBlock Text="Номер места / порядок в сетке" Style="{StaticResource LabLabel}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox Text="{Binding ComputerDraft.Seat}" IsReadOnly="{Binding LinkedPlacementReadOnly}" Margin="0,0,8,0"/><TextBox Grid.Column="1" Text="{Binding ComputerDraft.Position}"/></Grid>
        <StackPanel Margin="0,8,0,0"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding LinkedPlacementReadOnly}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
         <TextBlock Text="{Binding LinkedInventoryStatus}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/>
         <Button Content="Переместить в инвентаризации" Command="{Binding MoveInInventoryCommand}" Style="{StaticResource LabButton}" HorizontalAlignment="Left"/>
        </StackPanel>
        <TextBlock Text="Windows: адрес или DNS-имя" Style="{StaticResource LabLabel}"/><TextBox Text="{Binding WindowsAddress}"/>
        <TextBlock Text="Astra: адрес или DNS-имя" Style="{StaticResource LabLabel}"/><TextBox Text="{Binding AstraAddress}"/>
        <TextBlock Text="Проверенный отпечаток SSH (SHA256:…)" Style="{StaticResource LabLabel}"/><TextBox Text="{Binding SshFingerprint}"/>
       </StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="Аппаратный UUID" Style="{StaticResource LabLabel}"/><TextBox Text="{Binding ComputerDraft.Uuid}"/>
        <TextBlock Text="Серийный номер" Style="{StaticResource LabLabel}"/><TextBox Text="{Binding ComputerDraft.Serial}"/>
        <TextBlock Text="MAC-адреса (по одному на строку)" Style="{StaticResource LabLabel}"/><TextBox Text="{Binding MacText}" AcceptsReturn="True" Height="70"/>
        <TextBlock Text="Wake-on-LAN: broadcast подсети" Style="{StaticResource LabLabel}"/><TextBox Text="{Binding ComputerDraft.Broadcast}"/>
        <TextBlock Text="GRUB: обнаруженный ID пункта Windows" Style="{StaticResource LabLabel}"/><TextBox Text="{Binding ComputerDraft.WindowsMenuId}"/>
        <CheckBox Content="Испытание одноразовой загрузки выполнено" IsChecked="{Binding ComputerDraft.BootPilotVerified}" Margin="0,12,0,8"/>
       </StackPanel>
      </Grid>
      <TextBlock Text="Отметку GRUB сохраняйте после проверки Windows → Astra на тестовом ПК. При изменении конфигурации потребуется новое испытание." Style="{DynamicResource MutedText}" Margin="0,12,0,12"/>
      <WrapPanel><Button Content="Сохранить карточку" Command="{Binding SaveComputerCommand}" Style="{StaticResource LabButton}"/><Button Content="Заполнить ID из проверки" Command="{Binding FillIdentityCommand}" Style="{StaticResource LabButton}"/></WrapPanel><TextBlock Text="{Binding OsHistoryText}" TextWrapping="Wrap" Margin="0,14,0,0"/>
     </StackPanel></Border></Expander>
    </StackPanel>

    <StackPanel x:Name="PackagesPanel">
     <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Section, ElementName=LabRoot}" Value="Программы"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
     <TextBlock Text="Каталог программ" FontSize="25" FontWeight="SemiBold"/>
     <TextBlock Text="Установка на компьютеры, отмеченные в «Аудиториях». Для другой ОС задание будет отложено." Style="{DynamicResource MutedText}" Margin="0,6,0,14"/>
     <DataGrid ItemsSource="{Binding Packages}" SelectedItem="{Binding SelectedPackage}" Style="{StaticResource LabGrid}" Height="200"><DataGrid.Columns><DataGridTextColumn Header="Программа" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="ОС" Binding="{Binding Os}" Width="90"/><DataGridTextColumn Header="Версия" Binding="{Binding Version}" Width="130"/><DataGridTextColumn Header="Тип" Binding="{Binding Kind}" Width="70"/></DataGrid.Columns></DataGrid>
     <WrapPanel Margin="0,12,0,0"><Button Content="Установить на отмеченные ПК" Command="{Binding InstallCommand}" Style="{StaticResource LabButton}"/><Button Content="Новый пакет" Command="{Binding NewPackageCommand}" Style="{StaticResource LabButton}"/><Button Content="Удалить из каталога" Command="{Binding DeletePackageCommand}" Style="{StaticResource LabButton}"/></WrapPanel>
     <Expander Header="Добавить или изменить пакет" IsExpanded="True"><Border Style="{DynamicResource Card}" Margin="0,8,0,0"><StackPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="Название" Style="{StaticResource LabLabel}"/><TextBox Text="{Binding PackageDraft.Name}"/><TextBlock Text="Целевая ОС" Style="{StaticResource LabLabel}"/><ComboBox ItemsSource="{Binding OsChoices}" SelectedItem="{Binding PackageDraft.Os}"/><TextBlock Text="Тип" Style="{StaticResource LabLabel}"/><ComboBox ItemsSource="{Binding PackageKinds}" SelectedItem="{Binding PackageDraft.Kind}"/></StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="Точная ожидаемая версия" Style="{StaticResource LabLabel}"/><TextBox Text="{Binding PackageDraft.Version}"/><TextBlock Text="Архитектура" Style="{StaticResource LabLabel}"/><ComboBox ItemsSource="{Binding Architectures}" SelectedItem="{Binding PackageDraft.Architecture}"/><TextBlock Text="Проверка: полный путь EXE / имя dpkg-пакета" Style="{StaticResource LabLabel}"/><TextBox Text="{Binding PackageDraft.Detection}"/></StackPanel>
      </Grid>
      <TextBlock Text="Файл установщика или имя APT-пакета" Style="{StaticResource LabLabel}"/><DockPanel><Button DockPanel.Dock="Right" Content="Выбрать файл" Command="{Binding ChoosePackageCommand}" Margin="8,0,0,0"/><TextBox Text="{Binding PackageDraft.Source}"/></DockPanel>
      <TextBlock Text="SHA-256 выбранного файла" Style="{StaticResource LabLabel}"/><TextBox Text="{Binding PackageDraft.Sha256,Mode=OneWay}" IsReadOnly="True" FontSize="11"/>
      <TextBlock Text="Параметры тихой установки EXE" Style="{StaticResource LabLabel}"/><TextBox Text="{Binding PackageDraft.Arguments}"/>
      <CheckBox Content="Параметры EXE проверены: тихая установка без перезагрузки" IsChecked="{Binding PackageDraft.SilentNoRestartVerified}" Margin="0,12,0,12"/>
      <Button Content="Сохранить пакет" Command="{Binding SavePackageCommand}" HorizontalAlignment="Left"/>
     </StackPanel></Border></Expander>
     <Expander Header="Приложения, которые разрешено перезапускать"><Border Style="{DynamicResource Card}" Margin="0,8,0,0"><StackPanel>
      <ComboBox ItemsSource="{Binding Applications}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedApplication}"/>
      <TextBlock Text="Название / ОС" Style="{StaticResource LabLabel}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions><TextBox Text="{Binding ApplicationDraft.Name}" Margin="0,0,8,0"/><ComboBox Grid.Column="1" ItemsSource="{Binding OsChoices}" SelectedItem="{Binding ApplicationDraft.Os}"/></Grid>
      <TextBlock Text="Полный путь исполняемого файла на ПК" Style="{StaticResource LabLabel}"/><TextBox Text="{Binding ApplicationDraft.Path}"/>
      <TextBlock Text="Аргументы запуска" Style="{StaticResource LabLabel}"/><TextBox Text="{Binding ApplicationDraft.Arguments}"/>
      <WrapPanel Margin="0,12,0,0"><Button Content="Новое приложение" Command="{Binding NewApplicationCommand}" Style="{StaticResource LabButton}"/><Button Content="Сохранить приложение" Command="{Binding SaveApplicationCommand}" Style="{StaticResource LabButton}"/></WrapPanel>
     </StackPanel></Border></Expander>
    </StackPanel>

    <StackPanel x:Name="CleanupPanel">
     <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Section, ElementName=LabRoot}" Value="Очистка профилей"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
     <TextBlock Text="Студенческие профили Windows" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Удаляются локальные файлы и записи профиля в реестре. Учётные записи сохраняются. admin, администраторы и используемые профили защищены." Style="{DynamicResource MutedText}" Margin="0,6,0,14"/>
     <TextBlock Text="Список или маски студенческих логинов, по одному на строку" Style="{StaticResource LabLabel}"/><TextBox Text="{Binding OptionsDraft.StudentMasks}" AcceptsReturn="True" Height="75"/><WrapPanel Margin="0,12,0,0"><Button Content="Сохранить правила" Command="{Binding SaveOptionsCommand}" Style="{StaticResource LabButton}"/><Button Content="Проверить профили отмеченных ПК" Command="{Binding PreviewProfilesCommand}" Style="{StaticResource LabButton}"/><Button Content="Удалить выбранные профили" Command="{Binding CleanupCommand}" Style="{StaticResource LabButton}"/></WrapPanel>
     <DataGrid ItemsSource="{Binding Profiles}" Style="{StaticResource LabGrid}" Height="370" IsReadOnly="False"><DataGrid.Columns>
      <DataGridTemplateColumn Header="Удалить" Width="65"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Eligible}" HorizontalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTextColumn Header="Компьютер" Binding="{Binding Computer}" IsReadOnly="True" Width="130"/><DataGridTextColumn Header="Логин" Binding="{Binding Login}" IsReadOnly="True" Width="160"/><DataGridTextColumn Header="Каталог" Binding="{Binding Path}" IsReadOnly="True" Width="210"/><DataGridTextColumn Header="Причина исключения" Binding="{Binding Reason}" IsReadOnly="True" Width="230"/><DataGridTextColumn Header="SID" Binding="{Binding Sid}" IsReadOnly="True" Width="270"/>
     </DataGrid.Columns></DataGrid>
    </StackPanel>

    <StackPanel x:Name="MonitorPanel">
     <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Section, ElementName=LabRoot}" Value="Мониторинг"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
     <TextBlock Text="Состояние компьютеров" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Работает при открытом приложении. Повторные проблемы объединяются; история сохраняется." Style="{DynamicResource MutedText}" Margin="0,6,0,14"/>
     <WrapPanel><CheckBox Content="Автоматический опрос" IsChecked="{Binding OptionsDraft.Monitoring}" VerticalAlignment="Center" Margin="0,0,14,8"/><Button Content="Сохранить режим" Command="{Binding SaveOptionsCommand}" Style="{StaticResource LabButton}"/><Button Content="Обновить сейчас" Command="{Binding PollCommand}" Style="{StaticResource LabButton}"/></WrapPanel>
     <DataGrid ItemsSource="{Binding Alerts}" Style="{StaticResource LabGrid}" Height="240"><DataGrid.Columns><DataGridTextColumn Header="Состояние" Binding="{Binding StateText}" Width="95"/><DataGridTextColumn Header="Компьютер" Binding="{Binding Computer}" Width="135"/><DataGridTextColumn Header="Проблема" Binding="{Binding Message}" Width="*" MinWidth="270"/><DataGridTextColumn Header="Обнаружено" Binding="{Binding OpenedAt,StringFormat=dd.MM HH:mm}" Width="130"/><DataGridTextColumn Header="Устранено" Binding="{Binding ResolvedAt,StringFormat=dd.MM HH:mm}" Width="130"/></DataGrid.Columns></DataGrid>
     <TextBlock Text="Диагностика выбранного компьютера" FontSize="18" FontWeight="SemiBold" Margin="0,22,0,10"/>
     <DockPanel><Button DockPanel.Dock="Right" Content="Диагностика" Command="{Binding DiagnoseCommand}" Margin="8,0,0,0"/><ComboBox ItemsSource="{Binding Computers}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedComputer}"/></DockPanel>
     <TextBlock Text="{Binding HardwareText}" TextWrapping="Wrap" Margin="0,14,0,8"/><TextBlock Text="{Binding OsHistoryText}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
     <Expander Header="Готовность удалённого доступа и GRUB" IsExpanded="True"><TextBox Text="{Binding DiagnosticsText,Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="280" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0"/></Expander>
     <Expander Header="Диски"><DataGrid ItemsSource="{Binding Disks}" Style="{StaticResource LabGrid}" Height="180" Margin="0,8,0,0"><DataGrid.Columns><DataGridTextColumn Header="Раздел" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Свободно, %" Binding="{Binding FreePercent,StringFormat=F1}" Width="120"/><DataGridTextColumn Header="Свободно, байт" Binding="{Binding Free}" Width="170"/><DataGridTextColumn Header="Состояние" Binding="{Binding Health}" Width="200"/></DataGrid.Columns></DataGrid></Expander>
     <Expander Header="Службы"><DataGrid ItemsSource="{Binding Services}" Style="{StaticResource LabGrid}" Height="180" Margin="0,8,0,0"><DataGrid.Columns><DataGridTextColumn Header="Служба" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Состояние" Binding="{Binding State}" Width="*"/></DataGrid.Columns></DataGrid></Expander>
     <Expander Header="Процессы и перезапуск приложения"><StackPanel Margin="0,8,0,0"><DataGrid ItemsSource="{Binding Processes}" SelectedItem="{Binding SelectedProcess}" Style="{StaticResource LabGrid}" Height="240"><DataGrid.Columns><DataGridTextColumn Header="PID" Binding="{Binding Id}" Width="65"/><DataGridTextColumn Header="Процесс" Binding="{Binding Name}" Width="150"/><DataGridTextColumn Header="Пользователь" Binding="{Binding User}" Width="160"/><DataGridTextColumn Header="Путь" Binding="{Binding Path}" Width="300"/></DataGrid.Columns></DataGrid>
      <TextBlock Text="Выберите разрешённое приложение из каталога «Программы»" Style="{StaticResource LabLabel}"/><ComboBox ItemsSource="{Binding Applications}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedApplication}"/><Button Content="Запросить согласие и перезапустить" Command="{Binding RestartApplicationCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
     </StackPanel></Expander>
    </StackPanel>

    <StackPanel x:Name="JobsPanel">
     <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Section, ElementName=LabRoot}" Value="Задания"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
     <TextBlock Text="Задания и расписания" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Задания одного ПК выполняются последовательно. После потери связи сначала выполняется сверка результата." Style="{DynamicResource MutedText}" Margin="0,6,0,14"/>
     <DataGrid ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}" Style="{StaticResource LabGrid}" Height="260"><DataGrid.Columns><DataGridTextColumn Header="Компьютер" Binding="{Binding Computer}" Width="135"/><DataGridTextColumn Header="Операция" Binding="{Binding ActionText}" Width="170"/><DataGridTextColumn Header="Состояние" Binding="{Binding StateText}" Width="190"/><DataGridTextColumn Header="Результат" Binding="{Binding Detail}" Width="400"/><DataGridTextColumn Header="Время" Binding="{Binding CreatedAt,StringFormat=dd.MM HH:mm}" Width="130"/></DataGrid.Columns></DataGrid>
     <TextBox Text="{Binding SelectedJob.Detail,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="150" VerticalScrollBarVisibility="Auto" Margin="0,8,0,8"/><Button Content="Сверить выбранное задание" Command="{Binding ReconcileCommand}" HorizontalAlignment="Left"/>
     <Expander Header="Расписание питания" IsExpanded="True"><Border Style="{DynamicResource Card}" Margin="0,8,0,0"><StackPanel>
      <TextBlock Text="Расписание применяется к компьютерам, отмеченным в «Аудиториях». Пропущенные запуски не выполняются задним числом." Style="{DynamicResource MutedText}"/>
      <TextBlock Text="Название" Style="{StaticResource LabLabel}"/><TextBox Text="{Binding ScheduleName}"/>
      <TextBlock Text="Действие" Style="{StaticResource LabLabel}"/><ComboBox ItemsSource="{Binding PowerChoices}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding ScheduleAction}"/>
      <Grid Margin="0,12,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><DatePicker SelectedDate="{Binding ScheduleDate}"/><TextBox Grid.Column="1" Text="{Binding ScheduleTime}" Margin="8,0,8,0"/><CheckBox Grid.Column="2" Content="Еженедельно" IsChecked="{Binding ScheduleWeekly}" VerticalAlignment="Center"/></Grid>
      <WrapPanel><Button Content="Создать расписание" Command="{Binding SaveScheduleCommand}" Style="{StaticResource LabButton}"/><Button Content="Удалить выбранное" Command="{Binding DeleteScheduleCommand}" Style="{StaticResource LabButton}"/></WrapPanel>
      <DataGrid ItemsSource="{Binding Schedules}" SelectedItem="{Binding SelectedSchedule}" Style="{StaticResource LabGrid}" Height="180"><DataGrid.Columns><DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Следующий запуск" Binding="{Binding NextRun,StringFormat=g}" Width="180"/><DataGridCheckBoxColumn Header="Включено" Binding="{Binding Enabled}" Width="85"/><DataGridCheckBoxColumn Header="Каждую неделю" Binding="{Binding Weekly}" Width="115"/></DataGrid.Columns></DataGrid>
     </StackPanel></Border></Expander>
    </StackPanel>

    <Expander Header="Настройки классов: GLPI, SSH, защита профилей и мониторинг" Margin="0,24,0,0"><Border Style="{DynamicResource Card}" Margin="0,10,0,0"><StackPanel>
     <TextBlock Text="GLPI · REST API V1" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Адрес HTTPS (сертификат должен быть доверенным)" Style="{StaticResource LabLabel}"/><TextBox Text="{Binding OptionsDraft.GlpiUrl}"/>
     <TextBlock Text="ID сущности GLPI (пусто — все доступные)" Style="{StaticResource LabLabel}"/><TextBox Text="{Binding OptionsDraft.GlpiEntity}"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="User token" Style="{StaticResource LabLabel}"/><PasswordBox x:Name="GlpiUserSecret" Tag="glpi-user" PasswordChanged="SecretChanged"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="App token" Style="{StaticResource LabLabel}"/><PasswordBox x:Name="GlpiAppSecret" Tag="glpi-app" PasswordChanged="SecretChanged"/></StackPanel></Grid>
     <Button Content="Удалить сохранённые токены GLPI" Command="{Binding ClearGlpiSecretsCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
     <TextBlock Text="Astra · SSH" FontSize="18" FontWeight="SemiBold" Margin="0,22,0,0"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Пользователь SSH" Style="{StaticResource LabLabel}"/><TextBox Text="{Binding OptionsDraft.SshUser}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Порт" Style="{StaticResource LabLabel}"/><TextBox Text="{Binding OptionsDraft.SshPort}"/></StackPanel></Grid>
     <TextBlock Text="Пароль SSH или пароль закрытого ключа" Style="{StaticResource LabLabel}"/><PasswordBox x:Name="SshSecret" Tag="ssh" PasswordChanged="SecretChanged"/>
     <TextBlock Text="Закрытый ключ (пусто — вход по паролю)" Style="{StaticResource LabLabel}"/><DockPanel><Button DockPanel.Dock="Right" Content="Выбрать ключ" Command="{Binding ChooseKeyCommand}" Margin="8,0,0,0"/><TextBox Text="{Binding OptionsDraft.SshPrivateKey}"/></DockPanel>
     <Button Content="Удалить сохранённый секрет SSH" Command="{Binding ClearSshSecretCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
     <TextBlock Text="TigerVNC Viewer на компьютере администратора" Style="{StaticResource LabLabel}"/><DockPanel><Button DockPanel.Dock="Right" Content="Выбрать Viewer" Command="{Binding ChooseViewerCommand}" Margin="8,0,0,0"/><TextBox Text="{Binding OptionsDraft.ViewerPath}"/></DockPanel>
     <TextBlock Text="Защита профилей и мониторинг" FontSize="18" FontWeight="SemiBold" Margin="0,22,0,0"/>
     <TextBlock Text="Дополнительные защищённые логины / маски (admin и администраторы защищены всегда)" Style="{StaticResource LabLabel}"/><TextBox Text="{Binding OptionsDraft.ProtectedUsers}" AcceptsReturn="True" Height="65"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Службы Windows, по одной на строку" Style="{StaticResource LabLabel}"/><TextBox Text="{Binding OptionsDraft.WindowsServices}" AcceptsReturn="True" Height="65"/><TextBlock Text="Интервал опроса, секунд" Style="{StaticResource LabLabel}"/><TextBox Text="{Binding OptionsDraft.PollSeconds}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Службы Astra, по одной на строку" Style="{StaticResource LabLabel}"/><TextBox Text="{Binding OptionsDraft.AstraServices}" AcceptsReturn="True" Height="65"/><TextBlock Text="Предупреждать при свободном месте менее, %" Style="{StaticResource LabLabel}"/><TextBox Text="{Binding OptionsDraft.LowDiskPercent}"/></StackPanel></Grid>
     <TextBlock Text="Пустое поле секрета сохраняет прежнее значение. Пароли и токены не записываются в JSON или журнал." Style="{DynamicResource MutedText}" Margin="0,14,0,10"/>
     <WrapPanel><Button Content="Сохранить настройки классов" Command="{Binding SaveOptionsCommand}" Style="{StaticResource LabButton}"/><Button Content="Отмена изменений" Command="{Binding CancelOptionsCommand}" Style="{StaticResource LabButton}"/></WrapPanel>
    </StackPanel></Border></Expander>
   </StackPanel>
  </ScrollViewer>
  <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" Padding="24,12"><TextBlock Text="{Binding Message}" TextWrapping="Wrap" MaxHeight="95" ToolTip="{Binding Message}"/></Border>
 </Grid>
</UserControl>
